# JWT Settings
# Required. Generate a unique random value with: openssl rand -hex 32
# Must be at least 32 characters; the server refuses to start otherwise.
JWT_SECRET_KEY=

# Google OAuth Settings
# Required unless LOCAL_USER_EMAIL is set (see below): without local mode,
# Google sign-in is the only way into the app, so the server will not start
# until all three are set. In local mode Google sign-in is offered only if all
# three are set; empty values count as unset. See the README for how to create
# these. The redirect URI must match the one registered in Google Cloud exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/backend/oauth/google/callback

# Where a failed sign-in lands. Set this on any deployment, or users who fail
# to log in are sent to localhost.
# AUTH_FAILURE_REDIRECT=http://localhost:3000/auth/failure

# Allowed browser origins. This is also the allowlist of hosts a user may be
# returned to after signing in, so the site's own origin must be listed.
CORS_ORIGINS='["http://localhost:3000"]'

# MongoDB Settings
# docker compose sets this for the local containers; uncomment only when
# running the backend outside Docker or against a hosted database.
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_DATABASE=talleyrand

# Restrict who can sign in. Off by default, which means anyone with a Google
# account can use this instance.
# EMAIL_WHITELIST_ENABLED=true
# EMAIL_WHITELIST='["you@example.com"]'

# LOGGING_LEVEL=INFO

# Single-user local mode. Setting LOCAL_USER_EMAIL lets anyone who can reach
# the server sign in as this person without Google, so use it only for an
# instance nobody else can reach. The server then answers only requests
# addressed to localhost or 127.0.0.1.
# LOCAL_USER_EMAIL=you@example.com
# LOCAL_USER_NAME=Your Name

# Server-held Anthropic credentials (workload identity federation), used when a
# request brings no Anthropic API key. The command prints an identity token
# that your organization's federation rule trusts; the server exchanges it for
# a short-lived Anthropic access token. The rule and organization are required
# with the command; the service account and workspace are optional.
# ANTHROPIC_IDENTITY_TOKEN_COMMAND=print-identity-token
# ANTHROPIC_FEDERATION_RULE_ID=fdrl_your_rule
# ANTHROPIC_ORGANIZATION_ID=your-organization-id
# ANTHROPIC_SERVICE_ACCOUNT_ID=svac_your_service_account
# ANTHROPIC_WORKSPACE_ID=wrkspc_your_workspace

# Provider for the background features (kickstart, suggestions, big-picture
# questions, thread recaps, reports and case titles): openai or anthropic.
# BACKGROUND_PROVIDER=openai

# Whether the speech-to-text (dictation) endpoint is available.
# DICTATION_ENABLED=true
